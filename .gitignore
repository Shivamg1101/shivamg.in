# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# keep the template, ignore real secrets
!.env.example

# personal reference material — not for a public repo
Profile.pdf
design/*.png
# Generated résumés land here and carry a phone number and personal email. The
# one the site serves is public/Shivam-Gupta-Resume.pdf and stays tracked; these
# root copies are build output of the résumé template and must not be published.
/Shivam_Gupta_*.pdf
/*_Resume.pdf

# local screenshot scratch
.shots/
scripts/compiled/
