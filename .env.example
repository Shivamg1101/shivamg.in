# Supabase — both are safe in client code; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Resend — SERVER ONLY. Never prefix with NEXT_PUBLIC.
# Create at https://resend.com/api-keys after verifying shivamg.in
RESEND_API_KEY=

# Optional overrides. Sender must be on a domain verified in Resend.
CONTACT_FROM_EMAIL="Portfolio <contact@shivamg.in>"
# Defaults to profile.email from the database if unset.
CONTACT_TO_EMAIL=

# Pexels — SERVER ONLY. Free key from https://www.pexels.com/api/.
# Gives new drafts a cover automatically, and is what scripts/backfill-covers.ts
# searches with. Without it posts simply get no cover; nothing else breaks.
PEXELS_API_KEY=

# Supabase service role — SERVER ONLY, bypasses RLS. Needed by the draft ingest
# endpoint and by the cover backfill script.
SUPABASE_SERVICE_ROLE_KEY=
